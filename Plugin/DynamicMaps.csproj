<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>DynamicMaps</AssemblyName>
    <Description>Dynamic in-game maps for SPT</Description>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <!-- SPT 5.0.0 (SPTushonka) is IL2CPP: builds are no longer made against EscapeFromTarkov_Data\Managed,
         but against the BepInEx/interop stubs generated for the install, same as BepInEx/core. -->
    <TarkovDir Condition=" '$(TarkovDir)' == '' ">D:\SPT-5.0.0\DEV\</TarkovDir>
    <TarkovPluginsSPTDir>$(TarkovDir)BepInEx\plugins\sptushonka\</TarkovPluginsSPTDir>
    <TarkovInteropDir>$(TarkovDir)BepInEx\interop\</TarkovInteropDir>
    <TarkovBepInExCoreDir>$(TarkovDir)BepInEx\core\</TarkovBepInExCoreDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(TarkovInteropDir)Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="Comfort">
      <HintPath>$(TarkovInteropDir)Comfort.dll</HintPath>
    </Reference>
    <Reference Include="Comfort.Unity">
      <HintPath>$(TarkovInteropDir)Comfort.Unity.dll</HintPath>
    </Reference>
    <Reference Include="DissonanceVoip">
      <HintPath>$(TarkovInteropDir)DissonanceVoip.dll</HintPath>
    </Reference>
    <Reference Include="DOTween">
      <HintPath>$(TarkovInteropDir)DOTween.dll</HintPath>
    </Reference>
    <Reference Include="DOTween.Modules">
      <HintPath>$(TarkovInteropDir)DOTween.Modules.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(TarkovInteropDir)Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="Sirenix.Serialization">
      <HintPath>$(TarkovInteropDir)Sirenix.Serialization.dll</HintPath>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(TarkovInteropDir)Unity.TextMeshPro.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(TarkovInteropDir)UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(TarkovInteropDir)UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(TarkovInteropDir)UnityEngine.PhysicsModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(TarkovInteropDir)UnityEngine.ImageConversionModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(TarkovInteropDir)UnityEngine.InputLegacyModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(TarkovInteropDir)UnityEngine.IMGUIModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(TarkovInteropDir)UnityEngine.TextRenderingModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(TarkovInteropDir)UnityEngine.UI.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(TarkovInteropDir)UnityEngine.UIModule.dll</HintPath>
    </Reference>
    <Reference Include="Unity.VectorGraphics">
      <HintPath>$(TarkovInteropDir)Unity.VectorGraphics.dll</HintPath>
    </Reference>
    <Reference Include="Unity.InternalAPIEngineBridge.003">
      <HintPath>$(TarkovInteropDir)Unity.InternalAPIEngineBridge.003.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx.Core">
      <HintPath>$(TarkovBepInExCoreDir)BepInEx.Core.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(TarkovBepInExCoreDir)BepInEx.Unity.IL2CPP.dll</HintPath>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(TarkovBepInExCoreDir)0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(TarkovBepInExCoreDir)Il2CppInterop.Runtime.dll</HintPath>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(TarkovInteropDir)Il2Cppmscorlib.dll</HintPath>
    </Reference>
    <Reference Include="Il2CppSystem">
      <HintPath>$(TarkovInteropDir)Il2CppSystem.dll</HintPath>
    </Reference>
    <Reference Include="Il2CppSystem.Core">
      <HintPath>$(TarkovInteropDir)Il2CppSystem.Core.dll</HintPath>
    </Reference>
    <Reference Include="SPTushonka.Reflection">
      <HintPath>$(TarkovPluginsSPTDir)SPTushonka.Reflection.dll</HintPath>
    </Reference>
    <Reference Include="SPTushonka.Custom">
      <HintPath>$(TarkovPluginsSPTDir)SPTushonka.Custom.dll</HintPath>
    </Reference>
    <Reference Include="SPTushonka.Common">
      <HintPath>$(TarkovPluginsSPTDir)SPTushonka.Common.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Gets the version property from the VERSION.txt file -->
  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <ItemGroup>
      <VersionFile Include="VERSION.txt" />
      <VersionCs Include="$(ProjectDir)Version.cs" />
      <Compile Include="@(VersionCs)" Exclude="@(VersionCs)" /> <!-- Resolves double include -->
      <FileWrites Include="@(VersionCs)" />
    </ItemGroup>

    <ReadLinesFromFile File="@(VersionFile)">
      <Output TaskParameter="Lines" PropertyName="Version" />
    </ReadLinesFromFile>

    <!-- Write the version to Version.cs, kind of a hack to get version info into BepInEx -->
    <WriteLinesToFile File="@(VersionCs)" Overwrite="true" Lines="// HACK: autogenerated file containing version info from VERSION.txt" />
    <WriteLinesToFile File="@(VersionCs)" Lines="namespace DynamicMaps{public static class BuildInfo {public const string Version = &quot;$(Version)&quot;%3B}}" />
  </Target>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <ItemGroup>
      <ServerComponents Include="$(ProjectDir)../Server/bin/Release/mpstark-dynamicmaps/*.*" />
      <OutputDLL Include="$(ProjectDir)$(OutDir)$(TargetName).dll" />
      <License Include="$(ProjectDir)LICENSE" />
      <Resources Include="$(ProjectDir)Resources\**\*.*" />
      <!-- Unity.VectorGraphics / Unity.InternalAPIEngineBridge.003 are not part of the base game;
           this mod redistributes them. Under IL2CPP they need to land in BepInEx/interop, and whether a
           Mono-built copy of these still binds correctly against the IL2CPP UnityEngine types is unverified. -->
      <InteropRedistDlls Include="$(ProjectDir)../EscapeFromTarkov_Data\**\*.*" />
    </ItemGroup>

    <!-- Copies the output and resources to tarkov game folder -->
    <Copy SourceFiles="@(OutputDLL);@(Resources);@(License)" DestinationFolder="$(TarkovDir)BepInEx\plugins\mpstark-dynamicmaps\%(RecursiveDir)" />
    <Copy SourceFiles="@(InteropRedistDlls)" DestinationFolder="$(TarkovDir)BepInEx\interop\%(RecursiveDir)" />
    <Copy SourceFiles="@(ServerComponents)" DestinationFolder="$(TarkovDir)SPT_Runtime\user\mods\mpstark-dynamicmaps\%(RecursiveDir)" />

    <!-- Creates a release zip file -->
    <RemoveDir Directories="$(ProjectDir)release" />
    <Copy SourceFiles="@(OutputDLL);@(Resources);@(License)" DestinationFolder="$(ProjectDir)release\DynamicMaps\BepInEx\plugins\mpstark-dynamicmaps\%(RecursiveDir)" />
    <Copy SourceFiles="@(InteropRedistDlls)" DestinationFolder="$(ProjectDir)release\DynamicMaps\BepInEx\interop\%(RecursiveDir)" />
    <Copy SourceFiles="@(ServerComponents)" DestinationFolder="$(ProjectDir)release\DynamicMaps\SPT_Runtime\user\mods\mpstark-dynamicmaps\%(RecursiveDir)" />
    <ZipDirectory SourceDirectory="$(ProjectDir)release\DynamicMaps\" DestinationFile="$(ProjectDir)release\DynamicMaps-$(Version).zip" />
  </Target>

</Project>
